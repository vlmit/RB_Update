[TEXTPART Sequences MSSQL]
SELECT
	[t].*
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]								AS [SequenceID],
		[t].[Name]								AS [SequenceName],
		[i].[Created],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [SequencesInfo] AS [t] WITH (NOLOCK)
	INNER JOIN [Instances] AS [i] WITH (NOLOCK)
		ON [i].[ID] = [t].[ID]
	WHERE 1 = 1
		#param(Name, [t].[Name])
		#param(Created, [i].[Created])
	) AS [t]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART Sequences PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"									AS "SequenceID",
	"t"."Name"									AS "SequenceName",
	"i"."Created",
	0::int8										AS "rn"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "SequencesInfo" AS "t"
INNER JOIN "Instances" AS "i"
	ON "i"."ID" = "t"."ID"
WHERE true
	#param(Name, "t"."Name")
	#param(Created, "i"."Created")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}