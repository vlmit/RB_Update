[TEXTPART WorkflowSignalTypes MSSQL]
SELECT
	[st].[ID] as [SignalTypeID]
	,[st].[Name] as [SignalTypeName]
FROM [WorkflowSignalTypes] [st] WITH(NOLOCK)
WHERE 1 = 1
	#param(Name, [st].[Name])
ORDER BY #order_by

[TEXTPART WorkflowSignalTypes PGSQL]
SELECT
	"st"."ID" as "SignalTypeID"
	,"st"."Name" as "SignalTypeName"
FROM "WorkflowSignalTypes" "st"
WHERE true
	#param(Name, "st"."Name")
ORDER BY #order_by