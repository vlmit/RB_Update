[TEXTPART TaskKinds MSSQL]
SELECT
	[t].*
FROM (
	SELECT
		#if(Normal) {
		[t].[ID]								AS [KindID],
		[t].[Caption]							AS [KindCaption],
		row_number() OVER (ORDER BY #order_by)	AS [rn]
		}
		#if(Count) {
		count(*) AS [cnt]
		}
	FROM [TaskKinds] AS [t] WITH (NOLOCK)
	#if(Caption || Normal && request.SortedBy("KindCaption")) {
	CROSS APPLY [Localization]([t].[Caption], #param(locale)) AS [lCaption]
	}
	WHERE 1 = 1
		#param(Caption, [lCaption].[Value])
		#param(ID, [t].[ID])
	) AS [t]
#if(PageOffset) {
WHERE [t].[rn] >= #param(PageOffset) AND [t].[rn] < (#param(PageOffset) + #param(PageLimit))
}
#if(Normal) {
ORDER BY [t].[rn]
}

[TEXTPART TaskKinds PGSQL]
SELECT
	#if(Normal) {
	"t"."ID"								AS "KindID",
	"t"."Caption"							AS "KindCaption",
	0::int8									AS "rn"
	}
	#if(Count) {
	count(*) AS "cnt"
	}
FROM "TaskKinds" AS "t"
#if(Caption || Normal && request.SortedBy("KindCaption")) {
CROSS JOIN "Localization"("t"."Caption", #param(locale)) AS "lCaption"
}
WHERE true
	#param(Caption, "lCaption"."Value")
	#param(ID, "t"."ID")
#if(Normal) {
ORDER BY #order_by
}
#if(PageOffset) {
OFFSET #param(PageOffset) - 1 LIMIT #param(PageLimit)
}