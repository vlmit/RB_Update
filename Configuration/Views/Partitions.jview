[TEXTPART Partitions MSSQL]
SELECT
	[t].[ID]			AS [PartitionID],
	[t].[Name]			AS [PartitionName]
FROM [Partitions] AS [t] WITH (NOLOCK)
WHERE 1 = 1
	#param(PartitionID, [t].[ID])
	#param(Name, [t].[Name])
ORDER BY #order_by

[TEXTPART Partitions PGSQL]
SELECT
	"t"."ID"			AS "PartitionID",
	"t"."Name"			AS "PartitionName"
FROM "Partitions" AS "t"
WHERE true
	#param(PartitionID, "t"."ID")
	#param(Name, "t"."Name")
ORDER BY #order_by