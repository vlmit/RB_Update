[TEXTPART Languages MSSQL]
SELECT
	[l].[ID]			AS [LanguageID],
	[l].[Caption]		AS [LanguageCaption],
	[l].[Code]			AS [LanguageCode]
FROM [Languages] AS [l] WITH (NOLOCK)
WHERE 1 = 1
	#param(CaptionParam, [l].[Caption])
ORDER BY #order_by

[TEXTPART Languages PGSQL]
SELECT
	"l"."ID"			AS "LanguageID",
	"l"."Caption"		AS "LanguageCaption",
	"l"."Code"			AS "LanguageCode"
FROM "Languages" AS "l"
WHERE true
	#param(CaptionParam, "l"."Caption")
ORDER BY #order_by