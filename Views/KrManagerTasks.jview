[TEXTPART KrManagerTasks MSSQL]
CREATE TABLE #TaskTypes (
	[ID]			int not null primary key identity(1,1),
	[Caption]		nvarchar(128) null,
	[TypeCaption]	nvarchar(128) not null,
	[ActiveImage]	nvarchar(128) not null,
	[InactiveImage]	nvarchar(128) not null);

-- Здесь перечисляются названия типов или видов заданий в порядке их отображения.
-- Для каждого указывается имя типа задания, файла с изображением, отображаемым при выборе пункта,
-- и имя файла с изображением, отображаемым для невыбранного пункта.
-- Укажите в первой колонке null, чтобы не дублировать имя задания из второй колонки.
INSERT INTO #TaskTypes ([Caption], [TypeCaption], [ActiveImage], [InactiveImage]) VALUES
(null, 'На исполнение', 'PerformTask.png', 'PerformTask-inactive.png') ,
(null, 'На рассмотрение', 'InformTask.png', 'InformTask-inactive.png') ,
('На согласовании', '$CardTypes_TypesNames_KrApprove', 'ApproveTask.png', 'ApproveTask-inactive.png') ,
('На контроле', '$CardTypes_TypesNames_WfResolutionControl', 'ControlTask.png', 'ControlTask-inactive.png') ,
(null, 'Срочное поручение', 'UrgentTask.png', 'UrgentTask-inactive.png') ,
(null, 'Просроченное поручение', 'OverdueTask.png', 'OverdueTask-inactive.png');



SELECT
	[t].[TypeID],
	COALESCE([tt].[Caption], [tt].[TypeCaption]) AS [Caption],
	[tt].[ActiveImage],
	[tt].[InactiveImage],
	COALESCE([t2].[cnt], 0) + COALESCE([t3].[cnt], 0) AS [Count]
FROM (
	SELECT [tk].[ID] AS [TypeID], [tt].[ID] AS [Order]
	FROM #TaskTypes AS [tt]
	INNER JOIN [TaskKinds] AS [tk] WITH (NOLOCK) ON [tk].[Caption] = [tt].[TypeCaption]
	UNION ALL
	SELECT [t].[ID] AS [TypeID], [tt].[ID] AS [Order]
	FROM #TaskTypes AS [tt]
	INNER JOIN [Types] AS [t] WITH (NOLOCK) ON [t].[Caption] = [tt].[TypeCaption]
) AS [t]
INNER JOIN #TaskTypes AS [tt] ON [tt].[ID] = [t].[Order]
OUTER APPLY (
	SELECT COUNT(*) AS [cnt]
	FROM [Tasks] AS [tsk] WITH (NOLOCK)
	WHERE [tsk].[TypeID] = [t].[TypeID]
		AND (
			[tsk].[UserID] IS NOT NULL AND [tsk].[UserID] = #param(CurrentUserID)
			OR
			[tsk].[UserID] IS NULL
			AND
			EXISTS (
				SELECT NULL
				FROM [RoleUsers] AS [ru] WITH (NOLOCK)
				WHERE [ru].[ID] = [tsk].[RoleID]
					AND [ru].[UserID] = #param(CurrentUserID)
				)
			OR
			EXISTS (
				SELECT NULL
				FROM [RoleDeputies] AS [rd] WITH (NOLOCK)
				WHERE [rd].[ID] = [tsk].[RoleID]
					AND [rd].[IsActive] = 1
					AND [rd].[DeputyID] = #param(CurrentUserID)
					AND [rd].[DeputizedID] = [tsk].[UserID]
				)
		)
) AS [t2]
OUTER APPLY (
	SELECT COUNT(*) AS [cnt]
	FROM [TaskCommonInfo] AS [tci] WITH (NOLOCK)
	INNER JOIN [Tasks] AS [tsk] WITH (NOLOCK) ON [tsk].[RowID] = [tci].[ID]
	WHERE [tci].[KindID] = [t].[TypeID]
		AND (
			[tsk].[UserID] IS NOT NULL AND [tsk].[UserID] = #param(CurrentUserID)
			OR
			[tsk].[UserID] IS NULL
			AND
			EXISTS (
				SELECT NULL
				FROM [RoleUsers] AS [ru] WITH (NOLOCK)
				WHERE [ru].[ID] = [tsk].[RoleID]
					AND [ru].[UserID] = #param(CurrentUserID)
				)
			OR
			EXISTS (
				SELECT NULL
				FROM [RoleDeputies] AS [rd] WITH (NOLOCK)
				WHERE [rd].[ID] = [tsk].[RoleID]
					AND [rd].[IsActive] = 1
					AND [rd].[DeputyID] = #param(CurrentUserID)
					AND [rd].[DeputizedID] = [tsk].[UserID]
				)
		)
) t3
ORDER BY [t].[Order]

[TEXTPART KrManagerTasks PGSQL]
BEGIN

CREATE TEMP TABLE IF NOT EXISTS "task_types" (
	"ID"			SERIAL UNIQUE PRIMARY KEY,
	"Caption"		text,
	"TypeCaption"	text,
	"ActiveImage"	text,
	"InactiveImage"	text,
	"Bool"			text,
	"ViewID"		text,
	"LastDocID"		text);

-- Здесь перечисляются названия типов или видов заданий в порядке их отображения.
-- Для каждого указывается имя файла с изображением, отображаемым при выборе пункта,
-- и имя файла с изображением, отображаемым для невыбранного пункта.
INSERT INTO "task_types" ("Caption", "TypeCaption", "ActiveImage", "InactiveImage", "Bool", "ViewID","LastDocID") VALUES
('Все поступившие', '$CardTypes_TypesNames_KrApprove', 'PerformTask.png', 'PerformTask-inactive.png', 'true', 'MyTasks_AllForMob', '83091e9b-3989-4a75-ade4-9fbdbb57fedf') ,
('На рассмотрение', 'Регистрация документа, поступившего по МЭДО', 'InformTask.png', 'InformTask-inactive.png', 'false', 'MyTasks_InConsideration', '83091e9b-3989-4a75-ade4-9fbdbb57fedf') ,
('На согласовании', '$CardTypes_TypesNames_KrApprove', 'ApproveTask.png', 'ApproveTask-inactive.png', 'true', 'MyTasks_forApproval', '95c7dd8c-e8f7-4b8f-b901-99b4eabca3a7') ,
('На подпись', '$CardTypes_TypesNames_KrSigning', 'ControlTask.png', 'ControlTask-inactive.png', 'false', 'MyTasks_forSign', '83091e9b-3989-4a75-ade4-9fbdbb57fedf') ,
('В работе', '$CardTypes_TypesNames_KrRegistration', 'UrgentTask.png', 'UrgentTask-inactive.png', 'false', 'MyTasks_InProgress', '95c7dd8c-e8f7-4b8f-b901-99b4eabca3a7') ,
('История', '$CardTypes_TypesNames_KrApprove', 'OverdueTask.png', 'OverdueTask-inactive.png', 'false', 'MyCompletedTasks_forMob', '95c7dd8c-e8f7-4b8f-b901-99b4eabca3a7');



RETURN QUERY
SELECT
	"t"."TypeID",
	COALESCE("tt"."Caption", "tt"."TypeCaption") AS "Caption",
	"tt"."ActiveImage",
	"tt"."InactiveImage",
	case
		WHEN "tt"."Caption" = 'Все поступившие'  THEN 
			(select count(*) from "Tasks" as "tas" where "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae' and "tas"."StateID"= 0
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
			)
		WHEN "tt"."Caption" = 'На рассмотрение'  THEN 
			(select count(*) from "Tasks" as "tas" where "tas"."StateID"=0 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and ("tas"."TypeID"='2257bff2-1bdd-4f9a-aacd-dd93de844ea6' or "tas"."TypeID"='5309ce42-c4d2-4e99-a733-697c589311e7')
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
			)
		WHEN "tt"."Caption" = 'На согласовании'  THEN
			(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='e4d7f6bf-fea9-4a3b-8a5a-e1a0a40de74c'
				and "t"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
			)
		WHEN "tt"."Caption" = 'На подпись'  THEN
			(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='968d68b3-a7c5-4b5d-bfa4-bb0f346880b6'
				and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
			)
		WHEN "tt"."Caption" = 'В работе'  THEN
			(select count(*) from "Tasks" as "tas" where "tas"."StateID"=1 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
			)
		when"tt"."Caption"='История' then
			(select count(*) from "TaskHistory" where "UserID"=#param(CurrentUserID) and "Completed" is not null and extract(day from current_timestamp - "Completed") <= 14)
		end	
	as Count,
	CASE
			WHEN "tt"."Caption" = 'Все поступившие'  THEN 
				(select count(*) from "Tasks" as "tas" where "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae' and "tas"."StateID"= 0
					and (
					"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID) 
					or "tas"."UserID" is null 
					and 
					exists (
						select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
						and "ru"."UserID"=#param(CurrentUserID)
					)
					or 
					exists (
						select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
						and "rd"."IsActive"=true 
						and "rd"."DeputyID"=#param(CurrentUserID) 
						and "rd"."DeputizedID"="tas"."UserID"
						)
					) 
					and
					(select "th"."Created" from "TaskHistory" as "th" where 
						(
						"th"."RoleID" = #param(CurrentUserID) or "th"."RoleID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d"
												where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID) )
												or "th"."RoleID" IN (Select "ru"."ID" from "RoleUsers" as "ru"
												where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID" in (0,4))
						)
						and "th"."ID" = "tas"."ID" order by "th"."Created" desc limit 1) <= 
						  (select "ah"."Modified" from "ActionHistory" as "ah" where  "ah"."ModifiedByID" = #param(CurrentUserID)					 
						 and "ah"."ID" = "tas"."ID" order by "ah"."Modified" desc limit 1) is not true
					)
						
			WHEN "tt"."Caption" = 'На рассмотрение'  THEN 
				(select count(*) from "Tasks" as "tas" where "tas"."StateID"=0 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and ("tas"."TypeID"='2257bff2-1bdd-4f9a-aacd-dd93de844ea6' or "tas"."TypeID"='5309ce42-c4d2-4e99-a733-697c589311e7')
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
				and
				(select "th"."Created" from "TaskHistory" as "th" where 
					(
					"th"."RoleID" = #param(CurrentUserID) or "th"."RoleID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d"
											where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID) )
											or "th"."RoleID" IN (Select "ru"."ID" from "RoleUsers" as "ru"
											where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID" in (0,4))
					)
					and "th"."ID" = "tas"."ID" order by "th"."Created" desc limit 1) <= 
					  (select "ah"."Modified" from "ActionHistory" as "ah" where  "ah"."ModifiedByID" = #param(CurrentUserID)
					 and "ah"."ID" = "tas"."ID" order by "ah"."Modified" desc limit 1) is not true
				)
			WHEN "tt"."Caption" = 'На согласовании'  THEN 
				(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='e4d7f6bf-fea9-4a3b-8a5a-e1a0a40de74c'
				and "t"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
				and
				(select "th"."Created" from "TaskHistory" as "th" where 
					(
					"th"."RoleID" = #param(CurrentUserID) or "th"."RoleID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d"
											where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID) )
											or "th"."RoleID" IN (Select "ru"."ID" from "RoleUsers" as "ru"
											where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID" in (0,4))
					)
					and "th"."ID" = "tas"."ID" order by "th"."Created" desc limit 1) <= 
					  (select "ah"."Modified" from "ActionHistory" as "ah" where  "ah"."ModifiedByID" = #param(CurrentUserID)
					 and "ah"."ID" = "tas"."ID" order by "ah"."Modified" desc limit 1) is not true
			)
			WHEN "tt"."Caption" = 'На подпись'  THEN 
				(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='968d68b3-a7c5-4b5d-bfa4-bb0f346880b6'
				and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
				and (
				"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
				or "tas"."UserID" is null 
				and 
				exists (
					select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
					and "ru"."UserID"=#param(CurrentUserID)
				)
				or 
				exists (
					select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
					and "rd"."IsActive"=true 
					and "rd"."DeputyID"=#param(CurrentUserID) 
					and "rd"."DeputizedID"="tas"."UserID"
					)
				)
				and
				(select "th"."Created" from "TaskHistory" as "th" where 
					(
					"th"."RoleID" = #param(CurrentUserID) or "th"."RoleID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d"
											where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID) )
											or "th"."RoleID" IN (Select "ru"."ID" from "RoleUsers" as "ru"
											where "ru"."UserID" = #param(CurrentUserID) and "ru"."TypeID" in (0,4))
					)
					and "th"."ID" = "tas"."ID" order by "th"."Created" desc limit 1) <= 
					  (select "ah"."Modified" from "ActionHistory" as "ah" where  "ah"."ModifiedByID" = #param(CurrentUserID)
					 
					 and "ah"."ID" = "tas"."ID" order by "ah"."Modified" desc limit 1) is not true
			)
			WHEN "tt"."Caption" = 'В работе'  THEN 
				 (select count(*) from "Tasks" as "tas" where "tas"."StateID"=1 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
						and (
						"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
						or "tas"."UserID" is null 
						and 
						exists (
							select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
							and "ru"."UserID"=#param(CurrentUserID)
						)
						or 
						exists (
							select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
							and "rd"."IsActive"=true 
							and "rd"."DeputyID"=#param(CurrentUserID) 
							and "rd"."DeputizedID"="tas"."UserID"
							)
						)
						and 
						(select "th"."Created" from "TaskHistory" as "th" where 
								(
								"th"."RoleID" = #param(CurrentUserID) or "th"."RoleID" IN (Select "d"."DeputizedID" from "RoleDeputies" as "d"
														where "d"."IsActive" = true and "d"."DeputyID" = #param(CurrentUserID) )
														or "th"."RoleID" IN (Select "ru"."ID" from "RoleUsers" as "ru"
														where "ru"."UserID" = #param(CurrentUserID))
								)
								and "th"."ID" = "tas"."ID" order by "th"."Created" desc limit 1) <= 
							  (select "ah"."Modified" from "ActionHistory" as "ah" where  "ah"."ModifiedByID" = #param(CurrentUserID)	 
							 and "ah"."ID" = "tas"."ID" order by "ah"."Modified" desc limit 1) is not true
					)
			when"tt"."Caption"='История' then
				0::int8 --(select count(*) from "TaskHistory" where "UserID"=#param(CurrentUserID) and "Completed" is not null)
			END 			 AS "UnreadCount"
	,
	case
		WHEN "tt"."Caption" = 'Все поступившие'  THEN 
				case 
					(select count(*) from "Tasks" as "tas" where "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae' 
						and (
						"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
						or "tas"."UserID" is null 
						and 
						exists (
							select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
							and "ru"."UserID"=#param(CurrentUserID)
						)
						or 
						exists (
							select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
							and "rd"."IsActive"=true 
							and "rd"."DeputyID"=#param(CurrentUserID) 
							and "rd"."DeputizedID"="tas"."UserID"
							)
						)
						and 
						exists (select 1 from "DocumentCommonInfo" as "dci" where "dci"."ID"="tas"."ID" and 
							"dci"."UrgencyName" in ('Срочно','Важно', 'Оперативно', 'Да'))
					)
					when 0 then 'false'
					else 'true'
				end
		WHEN "tt"."Caption" = 'На рассмотрение'  THEN 
			case
				(select count(*) from "Tasks" as "tas" where "tas"."StateID"=0 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
					and ("tas"."TypeID"='2257bff2-1bdd-4f9a-aacd-dd93de844ea6' or "tas"."TypeID"='5309ce42-c4d2-4e99-a733-697c589311e7')
					and (
					"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
					or "tas"."UserID" is null 
					and 
					exists (
						select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
						and "ru"."UserID"=#param(CurrentUserID)
					)
					or 
					exists (
						select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
						and "rd"."IsActive"=true 
						and "rd"."DeputyID"=#param(CurrentUserID) 
						and "rd"."DeputizedID"="tas"."UserID"
						)
					)
					and 
						exists (select 1 from "DocumentCommonInfo" as "dci" where "dci"."ID"="tas"."ID" and 
							"dci"."UrgencyName" in ('Срочно','Важно', 'Оперативно', 'Да'))
				)
				when 0 then 'false'
				else 'true'
			end
		WHEN "tt"."Caption" = 'На согласовании'  THEN
			case
				(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='e4d7f6bf-fea9-4a3b-8a5a-e1a0a40de74c'
					and "t"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
					and (
					"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
					or "tas"."UserID" is null 
					and 
					exists (
						select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
						and "ru"."UserID"=#param(CurrentUserID)
					)
					or 
					exists (
						select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
						and "rd"."IsActive"=true 
						and "rd"."DeputyID"=#param(CurrentUserID) 
						and "rd"."DeputizedID"="tas"."UserID"
						)
					)
					and 
						exists (select 1 from "DocumentCommonInfo" as "dci" where "dci"."ID"="tas"."ID" and 
							"dci"."UrgencyName" in ('Срочно','Важно', 'Оперативно', 'Да'))
				)
				when 0 then 'false'
				else 'true'
			end
		WHEN "tt"."Caption" = 'На подпись'  THEN
			case
				(select count(*) from "Tasks" as "tas" where "tas"."TypeID"='968d68b3-a7c5-4b5d-bfa4-bb0f346880b6'
					and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
					and (
					"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
					or "tas"."UserID" is null 
					and 
					exists (
						select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
						and "ru"."UserID"=#param(CurrentUserID)
					)
					or 
					exists (
						select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
						and "rd"."IsActive"=true 
						and "rd"."DeputyID"=#param(CurrentUserID) 
						and "rd"."DeputizedID"="tas"."UserID"
						)
					)
					and 
						exists (select 1 from "DocumentCommonInfo" as "dci" where "dci"."ID"="tas"."ID" and 
							"dci"."UrgencyName" in ('Срочно','Важно', 'Оперативно', 'Да'))
				)
				when 0 then 'false'
				else 'true'
			end
		WHEN "tt"."Caption" = 'В работе'  THEN
			case
				(select count(*) from "Tasks" as "tas" where "tas"."StateID"=1 and "tas"."TypeID"!='929e345c-acdf-41ea-acb6-6bb308de73ae'
					and (
					"tas"."UserID" is not null and "tas"."UserID"= #param(CurrentUserID)
					or "tas"."UserID" is null 
					and 
					exists (
						select null from "RoleUsers" as "ru" where "ru"."ID"="tas"."RoleID" 
						and "ru"."UserID"=#param(CurrentUserID)
					)
					or 
					exists (
						select null from "RoleDeputies" as "rd" where "rd"."ID"="tas"."RoleID" 
						and "rd"."IsActive"=true 
						and "rd"."DeputyID"=#param(CurrentUserID) 
						and "rd"."DeputizedID"="tas"."UserID"
						)
					)
					and 
						exists (select 1 from "DocumentCommonInfo" as "dci" where "dci"."ID"="tas"."ID" and 
							"dci"."UrgencyName" in ('Срочно','Важно', 'Оперативно', 'Да'))
				)
				when 0 then 'false'
				else 'true'
			end
		when"tt"."Caption"='История' then
			'false'
		end AS "Urgently"
	,"tt"."ViewID" AS "ViewID"
	,"tt"."LastDocID" AS "LastDocID"
	--,
	--'ddd' AS "ViewID"
	--'ddd' AS "ViewID"
FROM (
	SELECT "tk"."ID" AS "TypeID", "tt"."ID" AS "Order"
	FROM "task_types" AS "tt"
	INNER JOIN "TaskKinds" AS "tk" ON "tk"."Caption" = "tt"."TypeCaption"
	UNION ALL
	SELECT "t"."ID" AS "TypeID", "tt"."ID" AS "Order"
	FROM "task_types" AS "tt"
	INNER JOIN "Types" AS "t" ON "t"."Caption" = "tt"."TypeCaption"
) AS "t"
INNER JOIN "task_types" AS "tt" ON "tt"."ID" = "t"."Order"
LEFT JOIN LATERAL (
	SELECT COUNT(*) AS "cnt"
	FROM "Tasks" AS "tsk"
	WHERE "tsk"."TypeID" = "t"."TypeID"
		AND (
			"tsk"."UserID" IS NOT NULL AND "tsk"."UserID" = #param(CurrentUserID)
			OR
			"tsk"."UserID" IS NULL
			AND
			EXISTS (
				SELECT NULL
				FROM "RoleUsers" AS "ru"
				WHERE "ru"."ID" = "tsk"."RoleID"
					AND "ru"."UserID" = #param(CurrentUserID)
				)
			OR
			EXISTS (
				SELECT NULL
				FROM "RoleDeputies" AS "rd"
				WHERE "rd"."ID" = "tsk"."RoleID"
					AND "rd"."IsActive" = true
					AND "rd"."DeputyID" = #param(CurrentUserID)
					AND "rd"."DeputizedID" = "tsk"."UserID"
				)
		)
) AS "t2" ON true
LEFT JOIN LATERAL (
	SELECT COUNT(*) AS "cnt"
	FROM "TaskCommonInfo" AS "tci"
	INNER JOIN "Tasks" AS "tsk" ON "tsk"."RowID" = "tci"."ID"
	WHERE "tci"."KindID" = "t"."TypeID"
		AND (
			"tsk"."UserID" IS NOT NULL AND "tsk"."UserID" = #param(CurrentUserID)
			OR
			"tsk"."UserID" IS NULL
			AND
			EXISTS (
				SELECT NULL
				FROM "RoleUsers" AS "ru"
				WHERE "ru"."ID" = "tsk"."RoleID"
					AND "ru"."UserID" = #param(CurrentUserID)
				)
			OR
			EXISTS (
				SELECT NULL
				FROM "RoleDeputies" AS "rd"
				WHERE "rd"."ID" = "tsk"."RoleID"
					AND "rd"."IsActive" = true
					AND "rd"."DeputyID" = #param(CurrentUserID)
					AND "rd"."DeputizedID" = "tsk"."UserID"
				)
		)
) AS "t3" ON true
ORDER BY "t"."Order";

END;