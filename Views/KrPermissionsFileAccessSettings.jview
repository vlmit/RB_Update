[TEXTPART KrPermissionsFileAccessSettings MSSQL]
SELECT
	[s].[ID]		AS [AccessSettingID],
	[s].[Name]		AS [AccessSettingName]
FROM [KrPermissionsFileAccessSettings] AS [s] WITH (NOLOCK)
#if(Name || request.SortedBy("AccessSettingName")) {
CROSS APPLY [Localization]([s].[Name], #param(locale)) AS [lName]
}
WHERE 1 = 1
	#param(Name, [lName].[Value])
	
ORDER BY #order_by

[TEXTPART KrPermissionsFileAccessSettings PGSQL]
SELECT
	"s"."ID"		AS "AccessSettingID",
	"s"."Name"		AS "AccessSettingName"
FROM "KrPermissionsFileAccessSettings" AS "s"
#if(Name || request.SortedBy("AccessSettingName")) {
CROSS JOIN "Localization"("s"."Name", #param(locale)) AS "lName"
}
WHERE true
	#param(Name, "lName"."Value")
	
ORDER BY #order_by